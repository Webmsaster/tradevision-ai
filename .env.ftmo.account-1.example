# =============================================================================
# Account 1 — V5_AMBER_MAX_PASSLOCK + Basket-18 + BNB 18/50 (60.27% Step-1 champion)
# =============================================================================
# Copy to .env.ftmo.account-1 and fill in <PLACEHOLDER> values.
# After filling real tokens: `chmod 600 .env.ftmo.account-1`.
#
# 2026-05-19 Single-Account Champion:
#   FTMO_TF=2h-trend-v5-amber-max-passlock + Basket-18 + BNB 18/50 cross-asset
#   tp_mult=1.10, kelly=0.5/60/20
#   Pass-rate Step-1: 60.27% (Rust strict, n=334, step=7d)
#   Voters: regime min-votes=2 with POC-Z + BB-Z-MR + supertrend + HMM + ad-line
#
# NOTE on cross-asset (BNB 18/50 + Basket-18):
#   The backtest --cross-asset-sym BNBUSDT --cross-asset-fast 18 --cross-asset-slow 50
#   override is NOT honored at runtime — the live bot reads CrossAssetFilter
#   from the CFG (templates.rs / ftmoDaytrade24h.ts). Before going live, the
#   V5_AMBER_MAX_PASSLOCK template must be patched to set:
#     crossAssetFilter = { symbol: "BNBUSDT", emaFastPeriod: 18, emaSlowPeriod: 50 }
#   See FOLLOWUP comment in this file. Same applies to RUBIN / TITANIUM / MR.

# === Strategy Selection ===
FTMO_TF=2h-trend-v5-amber-max-passlock
FTMO_ACCOUNT_ID=account1
FTMO_START_BALANCE=100000
FTMO_PROFIT_TARGET=0.10

# === Challenge-Start Gate (Live-Cluster-Detector, 24h warmup) ===
FTMO_START_GATE_ENABLED=1
FTMO_START_GATE_PATH=state/timing-gate.json
FTMO_START_GATE_WINDOW_HOURS=24
FTMO_START_GATE_MIN_BREADTH=4
FTMO_START_GATE_MIN_MAJORS=3
FTMO_START_GATE_MIN_HISTORY_HOURS=24
FTMO_START_GATE_MAX_AGE_MIN=180
FTMO_CLUSTER_ONLY_ENABLED=0

# === MT5 Login Validation ===
FTMO_EXPECTED_LOGIN=<ACCOUNT-1-MT5-LOGIN-NUMBER>

# === Risk Filters ===
REGIME_GATE_ENABLED=true
REGIME_GATE_BLOCK=trend-down
SLIPPAGE_ENTRY_SPREADS=1.5
SLIPPAGE_STOP_SPREADS=3.0

# === Telegram (master listener — only ONE account may set MASTER=1) ===
TELEGRAM_BOT_TOKEN_account1=<YOUR-BOT-TOKEN>
TELEGRAM_CHAT_ID_account1=<YOUR-CHAT-ID>
FTMO_TELEGRAM_BOT_MASTER=1

# === Drift Dashboard ===
FTMO_MONITOR_ENABLED=1
# /dashboard/drift?ftmo_tf=2h-trend-v5-amber-max-passlock-account1

# === News-Blackout ===
NEWS_BLACKOUT_ENABLED=true
NEWS_BLACKOUT_MIN_BEFORE=30
NEWS_BLACKOUT_MIN_AFTER=60
