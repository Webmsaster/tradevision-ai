# =============================================================================
# Account 3 — V5_TITANIUM_PASSLOCK + Basket-18 + BNB 18/50
# =============================================================================
# 2026-05-19 4-Stack Round 2 (Basket-18 + BNB 18/50 cross-asset):
#   Pass-rate Step-1: 41.76% (Rust strict, n=273 valid windows, step=7d)
#   On the 146 common windows with the rest of the stack: 39.73%
#   Voters: same as champion (POC-Z + BB-Z-MR + supertrend + HMM + ad-line)
#   tp_mult=1.10, kelly=0.5/60/20
#
# Why include despite lower pass-rate? Per-window correlation with
# AMBER_MAX_PASSLOCK is ~0.001 — virtually orthogonal failure modes.
# Adding TITANIUM to AMBER lifts 2-stack OR from 60.27% → 76.03% (+15.76pp),
# vs RUBIN which only lifts to 63.01% (corr +0.700 — redundant).

# === Strategy Selection ===
FTMO_TF=2h-trend-v5-titanium-passlock
FTMO_ACCOUNT_ID=account3
FTMO_START_BALANCE=100000
FTMO_PROFIT_TARGET=0.10

# === Challenge-Start Gate ===
FTMO_START_GATE_ENABLED=1
FTMO_START_GATE_PATH=state/timing-gate.json
FTMO_START_GATE_WINDOW_HOURS=24
FTMO_START_GATE_MIN_BREADTH=4
FTMO_START_GATE_MIN_MAJORS=3
FTMO_START_GATE_MIN_HISTORY_HOURS=24
FTMO_START_GATE_MAX_AGE_MIN=180
FTMO_CLUSTER_ONLY_ENABLED=0

# === MT5 Login Validation ===
FTMO_EXPECTED_LOGIN=<ACCOUNT-3-MT5-LOGIN-NUMBER>

# === Risk Filters ===
REGIME_GATE_ENABLED=true
REGIME_GATE_BLOCK=trend-down
SLIPPAGE_ENTRY_SPREADS=1.5
SLIPPAGE_STOP_SPREADS=3.0

# === Telegram (send-only — NO master) ===
TELEGRAM_BOT_TOKEN_account3=<SAME-BOT-TOKEN-AS-account1>
TELEGRAM_CHAT_ID_account3=<SAME-CHAT-ID-AS-account1>

# === Drift Dashboard ===
FTMO_MONITOR_ENABLED=1
# /dashboard/drift?ftmo_tf=2h-trend-v5-titanium-passlock-account3

# === News-Blackout ===
NEWS_BLACKOUT_ENABLED=true
NEWS_BLACKOUT_MIN_BEFORE=30
NEWS_BLACKOUT_MIN_AFTER=60
