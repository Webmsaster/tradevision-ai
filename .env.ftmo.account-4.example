# =============================================================================
# Account 4 — V5_AMBER_MAX_MR_PASSLOCK (mean-reversion) + Basket-18 + BNB 18/50
# =============================================================================
# 2026-05-19 4-Stack Round 2:
#   Pass-rate Step-1: 52.05% (Rust strict, n=146 valid windows, step=7d)
#   Signal-class: Mean-Reversion (RSI 14, oversold=25 / overbought=75, cooldown=8 bars)
#   Voters: regime min-votes=2 with POC-Z + BB-Z-MR + supertrend + HMM + ad-line
#   tp_mult=1.10, kelly=0.5/60/20
#
# 4th account — uses mean-reversion signal class for failure-mode decorrelation
# from the 3 trend-following stack members (AMBER_MAX / RUBIN / TITANIUM).

# === Strategy Selection ===
FTMO_TF=2h-trend-v5-amber-max-mr-passlock
FTMO_ACCOUNT_ID=account4
FTMO_START_BALANCE=100000
FTMO_PROFIT_TARGET=0.10

# === Challenge-Start Gate ===
FTMO_START_GATE_ENABLED=1
FTMO_START_GATE_PATH=state/timing-gate.json
FTMO_START_GATE_WINDOW_HOURS=24
FTMO_START_GATE_MIN_BREADTH=4
FTMO_START_GATE_MIN_MAJORS=3
FTMO_START_GATE_MIN_HISTORY_HOURS=24
FTMO_START_GATE_MAX_AGE_MIN=180
FTMO_CLUSTER_ONLY_ENABLED=0

# === MT5 Login Validation ===
FTMO_EXPECTED_LOGIN=<ACCOUNT-4-MT5-LOGIN-NUMBER>

# === Risk Filters ===
REGIME_GATE_ENABLED=true
REGIME_GATE_BLOCK=trend-down
SLIPPAGE_ENTRY_SPREADS=1.5
SLIPPAGE_STOP_SPREADS=3.0

# === Telegram (send-only) ===
TELEGRAM_BOT_TOKEN_account4=<SAME-BOT-TOKEN-AS-account1>
TELEGRAM_CHAT_ID_account4=<SAME-CHAT-ID-AS-account1>

# === Drift Dashboard ===
FTMO_MONITOR_ENABLED=1
# /dashboard/drift?ftmo_tf=2h-trend-v5-amber-max-mr-passlock-account4

# === News-Blackout ===
NEWS_BLACKOUT_ENABLED=true
NEWS_BLACKOUT_MIN_BEFORE=30
NEWS_BLACKOUT_MIN_AFTER=60
