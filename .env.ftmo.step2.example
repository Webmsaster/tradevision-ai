# =============================================================================
# Step 2 / Verification — 90%-mode single-account flow
# =============================================================================
# Copy to .env.ftmo.step2 and fill in the MT5/Telegram placeholders.
# Use after Step 1 has passed, or let tools/promote_to_step2.sh update your
# existing .env.ftmo automatically.

# Same strategy surface as Step 1, but with FTMO Verification target = 5%.
FTMO_TF=2h-trend-v5-amber-max-passlock-step2
FTMO_ACCOUNT_ID=step2
FTMO_START_BALANCE=100000
FTMO_PROFIT_TARGET=0.05

# Start gate: Step 2 must idle until Breadth/Majors are green too.
FTMO_START_GATE_ENABLED=1
FTMO_START_GATE_PATH=state/timing-gate.json
# Random-buy 90-mode: 2h b>=10 m>=1 measured ~94.1% purchase-weighted.
FTMO_START_GATE_WINDOW_HOURS=2
FTMO_START_GATE_MIN_BREADTH=10
FTMO_START_GATE_MIN_MAJORS=1
FTMO_START_GATE_MIN_HISTORY_HOURS=0
FTMO_START_GATE_MAX_AGE_MIN=180
# Fast-pass default: wait for the first green cluster, then trade normally.
# Set to 1 only for strict "new entries only while cluster is green" mode.
FTMO_CLUSTER_ONLY_ENABLED=0
FTMO_CLUSTER_ONLY_MIN_HISTORY_HOURS=0

# MT5 login validation.
FTMO_EXPECTED_LOGIN=<STEP2-MT5-LOGIN-NUMBER>

# Risk filters.
REGIME_GATE_ENABLED=true
REGIME_GATE_BLOCK=trend-down
SLIPPAGE_ENTRY_SPREADS=1.5
SLIPPAGE_STOP_SPREADS=3.0

# Telegram.
TELEGRAM_BOT_TOKEN_step2=<YOUR-BOT-TOKEN>
TELEGRAM_CHAT_ID_step2=<YOUR-CHAT-ID>

# Only one account/process should own Telegram commands.
# FTMO_TELEGRAM_BOT_MASTER=1
