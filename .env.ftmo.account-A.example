# Phase-Adaptive Stack-4 — Account A (SHORTS_AGG × 2 symmetric)
# Source: docs/PHASE_ADAPTIVE_STACK4_DEPLOY_PLAN.md (GA Stack-4 97.28% OOS)
FTMO_ACCOUNT_ID=A
FTMO_TF_P1=2h-trend-v5-amber-max-passlock-shorts-agg
FTMO_TF_P2=2h-trend-v5-amber-max-passlock-shorts-agg
FTMO_INITIAL_BALANCE=100000
FTMO_P1_TARGET=0.10
FTMO_P2_TARGET=0.05
FTMO_P1_MAX_DAYS=30
FTMO_P2_MAX_DAYS=60

# MT5 login (Account A FTMO Challenge)
FTMO_LOGIN=
FTMO_PASSWORD=
FTMO_SERVER=
FTMO_EXPECTED_LOGIN=

# Telegram (per-account: use A-specific token + chat-id)
