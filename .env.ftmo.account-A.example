# Phase-Adaptive Stack-4 — Account A
# Source: docs/PHASE_ADAPTIVE_STACK4_DEPLOY_PLAN.md (GA Stack-4 no-ext24 = 93.11% OOS)
#
# ⚠️ THIS FILE IS THE TELEGRAM-MASTER (FTMO_TELEGRAM_BOT_MASTER=1).
# ⚠️ If copying as template for a NEW account E/F: DELETE the FTMO_TELEGRAM_BOT_MASTER
# ⚠️ line below. Only ONE account in the stack may be the master (PM2 startup
# ⚠️ refuses to launch otherwise — KRIT audit fix).
FTMO_ACCOUNT_ID=A
FTMO_TF_P1=2h-trend-v5-amber-max-passlock-shorts-agg
FTMO_TF_P2=2h-trend-v5-amber-max-passlock-shorts-only
FTMO_INITIAL_BALANCE=100000
FTMO_P1_TARGET=0.10
FTMO_P2_TARGET=0.05
FTMO_P1_MAX_DAYS=30
FTMO_P2_MAX_DAYS=60

# MT5 login (Account A FTMO Challenge) — REQUIRED, supervisor refuses to start
# without these to prevent trading on the wrong account.
FTMO_LOGIN=
FTMO_PASSWORD=
FTMO_SERVER=
FTMO_EXPECTED_LOGIN=

# Telegram (Account-A is master — see warning above)
TELEGRAM_BOT_TOKEN_A=
TELEGRAM_CHAT_ID_A=
FTMO_TELEGRAM_BOT_MASTER=1

# Optional: supervisor polling interval (default 60s)
SUPERVISOR_POLL_SEC=60
