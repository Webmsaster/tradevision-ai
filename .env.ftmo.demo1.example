# =============================================================================
# Demo 1 — first FTMO Demo Account (single-account or multi-account first slot)
# =============================================================================
# Copy to .env.ftmo and fill in <PLACEHOLDER> values.
# `.env.ftmo*` is .gitignored — safe for tokens.
#
# SECURITY: After filling in real tokens, restrict file mode:
#   chmod 600 .env.ftmo
# This blocks other unix users on the VPS from reading your bot token.

# === Strategy Selection ===
# 90%-mode Step 1: current AMBER_MAX_PASSLOCK champion, start-gated.
FTMO_TF=2h-trend-v5-amber-max-passlock
FTMO_ACCOUNT_ID=demo1
FTMO_START_BALANCE=100000
FTMO_PROFIT_TARGET=0.10

# Challenge-Start-Gate: buy can be random, but trading stays idle until green.
FTMO_START_GATE_ENABLED=1
FTMO_START_GATE_PATH=state/timing-gate.json
# Random-buy 90-mode: 2h b>=10 m>=1 measured ~94.1% purchase-weighted.
FTMO_START_GATE_WINDOW_HOURS=2
FTMO_START_GATE_MIN_BREADTH=10
FTMO_START_GATE_MIN_MAJORS=1
FTMO_START_GATE_MIN_HISTORY_HOURS=0
FTMO_START_GATE_MAX_AGE_MIN=180
# Fast-pass default: wait for the first green cluster, then trade normally.
# Set to 1 only for strict "new entries only while cluster is green" mode.
FTMO_CLUSTER_ONLY_ENABLED=0
FTMO_CLUSTER_ONLY_MIN_HISTORY_HOURS=0

# === MT5 Login Validation (R57 — prevents trading on wrong account) ===
FTMO_EXPECTED_LOGIN=<YOUR-MT5-LOGIN-NUMBER>

# === Risk Filters ===
REGIME_GATE_ENABLED=true
REGIME_GATE_BLOCK=trend-down
SLIPPAGE_ENTRY_SPREADS=1.5
SLIPPAGE_STOP_SPREADS=3.0

# === Conservative Demo 1 (uncomment for safer first run) ===
# RISK_FRAC_HARD_CAP=0.3
# REGIME_GATE_BLOCK=trend-down,high-vol

# === Telegram (per-account convention from R57) ===
TELEGRAM_BOT_TOKEN_demo1=<YOUR-BOT-TOKEN>
TELEGRAM_CHAT_ID_demo1=<YOUR-CHAT-ID>
# Master listener gate — only ONE process consumes Telegram getUpdates
FTMO_TELEGRAM_BOT_MASTER=1

# === Drift Dashboard ===
FTMO_MONITOR_ENABLED=1

# === News-Blackout (Round 60 RECOMMENDED — +1pp live expected) ===
# Skips entries during 30min before / 60min after major releases (FOMC, CPI,
# Halving, ETF-decisions). 48 hardcoded 2026 events shipped in news_blackout.py.
# Enable Finnhub API for auto-refresh of new events.
NEWS_BLACKOUT_ENABLED=true
NEWS_BLACKOUT_MIN_BEFORE=30
NEWS_BLACKOUT_MIN_AFTER=60
# NEWS_API_KEY=<finnhub-token>            # uncomment for auto-refresh
