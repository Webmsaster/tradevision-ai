# =============================================================================
# Account 5 — V5_AMBER_MAX_PASSLOCK_BIDIR (long+short) + Basket-18 + BNB 18/50
# =============================================================================
# Copy to .env.ftmo.account-5 and fill in <PLACEHOLDER> values.
# After filling real tokens: `chmod 600 .env.ftmo.account-5`.
#
# 2026-05-23 Orthogonal 3-Stack (AMBER + BIDIR + MR, cross-signal-class, corr~0):
#   FTMO_TF=2h-trend-v5-amber-max-passlock-bidir
#   tp_mult=1.10, kelly=0.5/60/20
#   Same engine stack as AMBER_MAX_PASSLOCK but with disableShort=false on every
#   asset. Addresses the long-only fail mode where bear/range first-24h windows
#   make all 100% long entries lose simultaneously (88% of fails by Day 3).
#
# NOTE on cross-asset (BNB 18/50): backtest CLI override --cross-asset-sym
# BNBUSDT --cross-asset-fast 18 --cross-asset-slow 50 is NOT yet baked into the
# TS template — live signals will use the per-config default. See
# tools/ecosystem.4stack.config.js pre-deploy checklist item #2 (cross-asset
# CFG patch).

# === Strategy Selection ===
FTMO_TF=2h-trend-v5-amber-max-passlock-bidir
FTMO_ACCOUNT_ID=account5
FTMO_START_BALANCE=100000
FTMO_PROFIT_TARGET=0.10

# === Challenge-Start Gate (Live-Cluster-Detector, 24h warmup) ===
FTMO_START_GATE_ENABLED=1
FTMO_START_GATE_PATH=state/timing-gate.json
FTMO_START_GATE_WINDOW_HOURS=24
FTMO_START_GATE_MIN_BREADTH=4
FTMO_START_GATE_MIN_MAJORS=3
FTMO_START_GATE_MIN_HISTORY_HOURS=24
FTMO_START_GATE_MAX_AGE_MIN=180
FTMO_CLUSTER_ONLY_ENABLED=0

# === MT5 Login Validation ===
FTMO_EXPECTED_LOGIN=<ACCOUNT-5-MT5-LOGIN-NUMBER>

# === Risk Filters ===
REGIME_GATE_ENABLED=true
REGIME_GATE_BLOCK=trend-down
SLIPPAGE_ENTRY_SPREADS=1.5
SLIPPAGE_STOP_SPREADS=3.0

# === Telegram (send-only — master is on account-1) ===
TELEGRAM_BOT_TOKEN_account5=<SAME-BOT-TOKEN-AS-account1>
TELEGRAM_CHAT_ID_account5=<SAME-CHAT-ID-AS-account1>

# === Drift Dashboard ===
FTMO_MONITOR_ENABLED=1
# /dashboard/drift?ftmo_tf=2h-trend-v5-amber-max-passlock-bidir-account5

# === News-Blackout ===
NEWS_BLACKOUT_ENABLED=true
NEWS_BLACKOUT_MIN_BEFORE=30
NEWS_BLACKOUT_MIN_AFTER=60
